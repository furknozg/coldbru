# Copy to .env and adjust. Values here are local-development defaults only.

# Claude API (the backend reads it from .env)
ANTHROPIC_API_KEY=

# Which model the proposal service uses (D-072): auto = the real model when ANTHROPIC_API_KEY is set,
# the built-in mock (no network, canned answers marked "[mock]" for unknown briefs) when it is empty;
# anthropic = the real model, refuses to start without a key; mock = always the mock.
LLM_MODE=auto

# Postgres superuser (init only; applications never use it)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# customer service role, owner of customer_db
CUSTOMER_DB_PASSWORD=customer_svc_dev

# Customer GraphQL bearer tokens, one per caller (D-063). Dev-only values: replace them outside
# local development. They must differ from each other; customer refuses to start otherwise.
# proposal: audience:read, notification: consent:read, admin: consent:write + consent:read (developer commands only)
CUSTOMER_TOKEN_PROPOSAL=proposal-dev-token
CUSTOMER_TOKEN_NOTIFICATION=notification-dev-token
CUSTOMER_TOKEN_ADMIN=admin-dev-token

# proposal service role, owner of proposal_db
PROPOSAL_DB_PASSWORD=proposal_svc_dev

# notification service role, owner of notification_db
NOTIFICATION_DB_PASSWORD=notification_svc_dev

# analytics service role, owner of analytics_db
ANALYTICS_DB_PASSWORD=analytics_svc_dev

# Host port for Postgres (5432 is often taken by other local projects)
POSTGRES_HOST_PORT=5433

# Host ports for NATS client and monitoring (change if 4222/8222 are taken)
NATS_HOST_PORT=4222
NATS_MONITOR_HOST_PORT=8222

# Host ports for the Go services (customer has none: compose network only)
PROPOSAL_HOST_PORT=8081
NOTIFICATION_HOST_PORT=8082
ANALYTICS_HOST_PORT=8083
MOCKPROVIDER_HOST_PORT=8084

# Host port of the web gateway (D-085): the app at http://localhost:8080 and /api/<service>/ behind it
WEB_HOST_PORT=8080

# Host ports for the mock provider's inboxes (D-081): Mailpit UI (emails) and MockServer (SMS dashboard
# at /mockserver/dashboard)
MAILPIT_UI_HOST_PORT=8025
MOCKSERVER_HOST_PORT=1080

# Mock provider behaviour (D-081): per request 5% 502/503, 2% 429 with Retry-After, 1% accepted but the
# answer held back; 50-300 ms latency; 110 requests/s per channel. Set the rates to 0 for a quiet run.
# MOCK_SEED makes the random choices repeatable (empty = random).
MOCK_ERROR_RATE=0.05
MOCK_RATE_429=0.02
MOCK_TIMEOUT_RATE=0.01
MOCK_TIMEOUT_DELAY=12s
MOCK_LATENCY_MIN=50ms
MOCK_LATENCY_MAX=300ms
MOCK_RATE_LIMIT=110
MOCK_IDEMPOTENCY_TTL=24h
MOCK_EMAIL_FROM=campaigns@coldbru.test
MOCK_SEED=

# Serve /docs (Scalar) and /openapi.json on the REST services; dev default, set false for production-like runs
API_DOCS_ENABLED=true

# Campaign content (D-071): the button link of every email (utm_campaign is added), and the demo
# prices (USD) behind the cost estimates. Not the rates of a real provider.
CAMPAIGN_CTA_URL=https://shop.example.com
SMS_SEGMENT_PRICE_USD=0.04
EMAIL_PRICE_USD=0.001

# Analytics (D-083): optional overrides of the model price table, a JSON object. Prices are USD per
# million tokens: input, output, cache_write, cache_read, as decimal strings (up to 6 decimals). An
# entry changes only the prices it names; the defaults are claude-sonnet-5-5 2 / 10 / 2.5 / 0.20,
# claude-haiku-5-5 0.10 / 0.50 / 0.125 / 0.01 and mock 0 / 0 / 0 / 0. A model without a price costs 0
# and Analytics logs a warning. Leave empty for the defaults, for example:
# LLM_PRICES={"claude-sonnet-5-5":{"cache_read":"0.10"}}
LLM_PRICES=
