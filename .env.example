# Copy to .env and adjust. Values here are local-development defaults only.

# Claude API (the backend reads it from .env)
ANTHROPIC_API_KEY=

# Postgres superuser (init only; applications never use it)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# customer service role, owner of customer_db
CUSTOMER_DB_PASSWORD=customer_svc_dev

# Host port for Postgres (5432 is often taken by other local projects)
POSTGRES_HOST_PORT=5433
